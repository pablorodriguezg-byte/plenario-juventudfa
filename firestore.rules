rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Red de seguridad global (Denegar todo por defecto)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitivas globales
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsernameKey(usernameKey) {
      return usernameKey is string
        && usernameKey.size() >= 2
        && usernameKey.size() <= 64
        && usernameKey.matches('^[a-z0-9._\\-]+$');
    }

    function isValidRoomId(roomId) {
      return roomId in ['synthesis', 'roster', 'actas', 'order_motions'];
    }

    function isAccreditedUsername(usernameKey) {
      return isValidUsernameKey(usernameKey)
        && exists(/databases/$(database)/documents/accredited_users/$(usernameKey));
    }

    function isSecretaryUsername(usernameKey) {
      return isAccreditedUsername(usernameKey)
        && get(/databases/$(database)/documents/accredited_users/$(usernameKey)).data.role == 'SECRETARY';
    }

    function isDelegateUsername(usernameKey, delegateId) {
      return isAccreditedUsername(usernameKey)
        && get(/databases/$(database)/documents/accredited_users/$(usernameKey)).data.role == 'DELEGATE'
        && get(/databases/$(database)/documents/accredited_users/$(usernameKey)).data.id == delegateId;
    }

    // 3. Blueprints de validación estática (sin lecturas a BD)
    function isValidAccreditedUser(data) {
      return data.keys().hasAll([
          'id', 'name', 'username', 'usernameLower', 'region',
          'role', 'isOnline', 'hasSpokenInCurrentMotion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'username', 'usernameLower', 'region',
          'role', 'organization', 'avatarUrl', 'isOnline',
          'hasSpokenInCurrentMotion', 'lastSessionId', 'actorUsernameLower',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 64
        && isValidUsernameKey(data.usernameLower)
        && data.region is string && data.region.size() >= 1 && data.region.size() <= 80
        && data.role in ['DELEGATE', 'SECRETARY']
        && (!('organization' in data) || (data.organization is string && data.organization.size() <= 200))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && data.isOnline is bool
        && data.hasSpokenInCurrentMotion is bool
        && (!('lastSessionId' in data) || (data.lastSessionId is string && data.lastSessionId.size() <= 128))
        && (!('actorUsernameLower' in data) || isValidUsernameKey(data.actorUsernameLower))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoomDoc(roomId, data) {
      return data.keys().hasAll(['kind', 'updatedByUid', 'updatedByUsernameLower', 'updatedAt'])
        && data.keys().hasOnly(['kind', 'chapters', 'motionsEnabledGlobal', 'delegatesPublic', 'items', 'updatedByUid', 'updatedByUsernameLower', 'updatedAt'])
        && data.kind == roomId
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && isValidUsernameKey(data.updatedByUsernameLower)
        && data.updatedAt is timestamp
        && (!('motionsEnabledGlobal' in data) || data.motionsEnabledGlobal is bool)
        && (
          (roomId == 'synthesis' && 'chapters' in data && data.chapters is list && data.chapters.size() <= 100)
          || (roomId == 'roster' && 'delegatesPublic' in data && data.delegatesPublic is list && data.delegatesPublic.size() <= 500)
          || (roomId == 'actas' && 'items' in data && data.items is list && data.items.size() <= 100)
          || (roomId == 'order_motions' && 'items' in data && data.items is list && data.items.size() <= 200)
        );
    }

    function isValidMotion(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'code', 'motionKind', 'title', 'description',
          'proposedBy', 'status', 'quorumType', 'createdAtMs', 'durationSeconds',
          'authorUid', 'actorUsernameLower', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'code', 'motionKind', 'title', 'description',
          'proposedBy', 'status', 'quorumType', 'createdAtMs', 'startedAtMs', 'closedAtMs',
          'durationSeconds', 'targetParagraphId', 'targetParagraphNumber',
          'originalParagraphText', 'proposedExtensionText', 'proposedEditedText',
          'dissensusId', 'dissensusOptions', 'runoffOptions', 'resultSummary',
          'authorUid', 'actorUsernameLower', 'updatedByUsernameLower',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.roomId == 'main'
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.motionKind in [
          'MOCION_EXTENSIVA', 'MOCION_SUPRESIVA', 'DISENSO_PRIMERA_VUELTA',
          'DISENSO_SEGUNDA_VUELTA', 'GENERAL_PRESINTESIS', 'GENERAL_SINTESIS_FINAL',
          'MOCION_ORDINARIA'
        ]
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && data.description is string && data.description.size() <= 4000
        && data.proposedBy is string && data.proposedBy.size() >= 1 && data.proposedBy.size() <= 200
        && data.status in ['DRAFT', 'OPEN', 'VOTING', 'CLOSED', 'APPROVED', 'REJECTED', 'PASSED_TO_RUNOFF']
        && data.quorumType in ['SIMPLE_MAJORITY', 'TWO_THIRDS', 'ABSOLUTE_MAJORITY']
        && data.createdAtMs is number
        && (!('startedAtMs' in data) || data.startedAtMs is number)
        && (!('closedAtMs' in data) || data.closedAtMs is number)
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && (!('targetParagraphId' in data) || (data.targetParagraphId is string && data.targetParagraphId.size() <= 128))
        && (!('targetParagraphNumber' in data) || (data.targetParagraphNumber is string && data.targetParagraphNumber.size() <= 32))
        && (!('originalParagraphText' in data) || (data.originalParagraphText is string && data.originalParagraphText.size() <= 15000))
        && (!('proposedExtensionText' in data) || (data.proposedExtensionText is string && data.proposedExtensionText.size() <= 15000))
        && (!('proposedEditedText' in data) || (data.proposedEditedText is string && data.proposedEditedText.size() <= 15000))
        && (!('dissensusId' in data) || (data.dissensusId is string && data.dissensusId.size() <= 128))
        && (!('dissensusOptions' in data) || data.dissensusOptions is map)
        && (!('runoffOptions' in data) || (data.runoffOptions is list && data.runoffOptions.size() == 2 && data.runoffOptions[0] is string))
        && (!('resultSummary' in data) || data.resultSummary is map)
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && isValidUsernameKey(data.actorUsernameLower)
        && (!('updatedByUsernameLower' in data) || isValidUsernameKey(data.updatedByUsernameLower))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVote(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'motionId', 'delegateId', 'delegateUsernameLower',
          'delegateName', 'region', 'vote', 'timestamp', 'digitalSignatureHash',
          'authorUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'motionId', 'delegateId', 'delegateUsernameLower',
          'delegateName', 'region', 'vote', 'timestamp', 'digitalSignatureHash', 'notes',
          'authorUid', 'createdAt'
        ])
        && isValidId(data.id)
        && data.roomId == 'main'
        && isValidId(data.motionId)
        && isValidId(data.delegateId)
        && isValidUsernameKey(data.delegateUsernameLower)
        && data.delegateName is string && data.delegateName.size() >= 1 && data.delegateName.size() <= 160
        && data.region is string && data.region.size() >= 1 && data.region.size() <= 80
        && data.vote in ['A_FAVOR', 'EN_CONTRA', 'ABSTENCION', 'OPCION_A', 'OPCION_B', 'OPCION_C']
        && data.timestamp is number
        && data.digitalSignatureHash is string && data.digitalSignatureHash.size() >= 4 && data.digitalSignatureHash.size() <= 128
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'roomId', 'timestamp', 'isoTime', 'delegateId',
          'delegateName', 'ipAddress', 'action', 'details',
          'integrityHash', 'authorUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'roomId', 'timestamp', 'isoTime', 'delegateId',
          'delegateName', 'ipAddress', 'action', 'details',
          'integrityHash', 'authorUid', 'createdAt'
        ])
        && isValidId(data.id)
        && data.roomId == 'main'
        && data.timestamp is number
        && data.isoTime is string && data.isoTime.size() >= 1 && data.isoTime.size() <= 64
        && data.delegateId is string && data.delegateId.size() >= 1 && data.delegateId.size() <= 128
        && data.delegateName is string && data.delegateName.size() >= 1 && data.delegateName.size() <= 200
        && data.ipAddress is string && data.ipAddress.size() >= 1 && data.ipAddress.size() <= 64
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.details is string && data.details.size() >= 1 && data.details.size() <= 1000
        && data.integrityHash is string && data.integrityHash.size() >= 4 && data.integrityHash.size() <= 128
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.createdAt is timestamp;
    }

    // 4. Padrón Oficial (acceso por nombre de usuario)
    match /accredited_users/{usernameKey} {
      allow get: if isValidUsernameKey(usernameKey);

      allow list: if existing().role in ['DELEGATE', 'SECRETARY'];

      allow create: if isValidUsernameKey(usernameKey)
        && isValidAccreditedUser(incoming())
        && incoming().usernameLower == usernameKey
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          usernameKey in ['secretaria', 'pablo.rodriguez']
          || ('actorUsernameLower' in incoming() && isSecretaryUsername(incoming().actorUsernameLower))
        );

      allow update: if isValidUsernameKey(usernameKey)
        && isValidAccreditedUser(incoming())
        && incoming().usernameLower == usernameKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            'actorUsernameLower' in incoming()
            && isSecretaryUsername(incoming().actorUsernameLower)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'id', 'name', 'username', 'region', 'role',
              'organization', 'avatarUrl', 'isOnline',
              'hasSpokenInCurrentMotion', 'lastSessionId',
              'actorUsernameLower', 'updatedAt'
            ])
          )
          || (
            incoming().id == existing().id
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isOnline', 'lastSessionId', 'updatedAt'
            ])
          )
        );

      allow delete: if isValidUsernameKey(usernameKey)
        && !(usernameKey in ['secretaria', 'pablo.rodriguez']);
    }

    // 5. Estado compartido de sala (Presíntesis, Padrón Público, Actas, Mociones de Orden)
    match /plenario_rooms/{roomId} {
      allow get: if isValidRoomId(roomId);
      allow list: if false;

      allow create: if isValidRoomId(roomId)
        && isValidRoomDoc(roomId, incoming())
        && incoming().updatedAt == request.time
        && isSecretaryUsername(incoming().updatedByUsernameLower);

      allow update: if isValidRoomId(roomId)
        && isValidRoomDoc(roomId, incoming())
        && incoming().kind == existing().kind
        && incoming().updatedAt == request.time
        && (
          (
            isSecretaryUsername(incoming().updatedByUsernameLower)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'chapters', 'motionsEnabledGlobal', 'delegatesPublic', 'items',
              'updatedByUid', 'updatedByUsernameLower', 'updatedAt'
            ])
          )
          || (
            roomId == 'order_motions'
            && isAccreditedUsername(incoming().updatedByUsernameLower)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'items', 'updatedByUid', 'updatedByUsernameLower', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 6. Mociones y Votaciones Parlamentarias
    match /motions/{motionId} {
      allow get: if isValidId(motionId);

      allow list: if existing().roomId == 'main';

      allow create: if isValidId(motionId)
        && isValidMotion(incoming())
        && incoming().id == motionId
        && incoming().roomId == 'main'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSecretaryUsername(incoming().actorUsernameLower)
          || (
            isAccreditedUsername(incoming().actorUsernameLower)
            && incoming().status == 'DRAFT'
            && incoming().motionKind in ['MOCION_EXTENSIVA', 'MOCION_SUPRESIVA']
          )
        );

      allow update: if isValidId(motionId)
        && isValidMotion(incoming())
        && incoming().id == existing().id
        && incoming().roomId == existing().roomId
        && incoming().authorUid == existing().authorUid
        && incoming().actorUsernameLower == existing().actorUsernameLower
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && 'updatedByUsernameLower' in incoming()
        && isSecretaryUsername(incoming().updatedByUsernameLower)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'startedAtMs', 'closedAtMs', 'resultSummary',
          'title', 'description', 'updatedByUsernameLower', 'updatedAt'
        ]);

      allow delete: if isValidId(motionId);
    }

    // 7. Sufragios Nominales Inmutables (1 voto por delegado por moción)
    match /votes/{voteId} {
      allow get: if isValidId(voteId);

      allow list: if existing().roomId == 'main';

      allow create: if isValidId(voteId)
        && isValidVote(incoming())
        && voteId == (incoming().motionId + '__' + incoming().delegateId)
        && incoming().id == voteId
        && incoming().roomId == 'main'
        && incoming().createdAt == request.time
        && isDelegateUsername(incoming().delegateUsernameLower, incoming().delegateId)
        && exists(/databases/$(database)/documents/motions/$(incoming().motionId))
        && get(/databases/$(database)/documents/motions/$(incoming().motionId)).data.status == 'VOTING';

      allow update: if false;

      allow delete: if isValidId(voteId);
    }

    // 8. Bitácora de Auditoría de Fe Pública (inmutable)
    match /audit_logs/{logId} {
      allow get: if isValidId(logId);

      allow list: if existing().roomId == 'main';

      allow create: if isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().roomId == 'main'
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if false;
    }

  }
}
